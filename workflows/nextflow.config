conda {
    enabled = true
    condaExe = "$HOME/miniconda3/bin/conda"
    cacheDir = "$HOME/nextflow_conda_cache" // cria um ambiente conda com as dependências no computador de quem está rodando o nextflow
}

// habilitando o ambiente conda para todos os processos
process {
    conda = "${projectDir}/environment.yaml"
}

env {
    PYTHONPATH = "${projectDir}/.."
}

params { 
    // single execution
    genome_fasta = "${projectDir}/examples/sample_genome.fna";
    lysozyme_fasta = "${projectDir}/examples/lysozymes.fasta";

    // batch execution
    // input_dir = "${projectDir}/examples/input_dir/" 
    output_dir = "batch_output/" 
    
    makeblastdb_path = "makeblastdb";
    tblastn_path = "tblastn";
    ssearch_path = "ssearch36";

    output_folder = "${projectDir}/output";
    output_blast = "${params.output_folder}/blast"; 
    output_ssearch = "${params.output_folder}/ssearch";
    output_merge = "${params.output_folder}/merge";
    output_final_dir = "${params.output_folder}/final";

    min_disablements = 1;
    min_coverage = 0.8;
    min_identity = 20
    final_min_identity = 0;
    min_score = 120;
    num_threads = 1;
}
